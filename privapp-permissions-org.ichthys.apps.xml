<!-- IchthysOS: privileged permissions for Ichthys Apps (ro.control_privapp_permissions=enforce).
     Only the "privileged" protection-level permissions are listed; the normal ones
     (UPDATE_PACKAGES_WITHOUT_USER_ACTION, ENFORCE_UPDATE_OWNERSHIP, RUN_USER_INITIATED_JOBS,
     QUERY_ALL_PACKAGES, INTERNET, ...) need no allowlist. -->
<permissions>
    <privapp-permissions package="org.ichthys.apps">
        <permission name="android.permission.INSTALL_PACKAGES" />
        <permission name="android.permission.DELETE_PACKAGES" />
        <permission name="android.permission.MANAGE_ICHTHYS_CONFIG" />
    </privapp-permissions>
</permissions>
